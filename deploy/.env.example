ENVIRONMENT=<staging-or-production>
# Production required: deployment phase selected by the release operator.
RELEASE_PHASE=<release-phase>
DATABASE_URL=<staging-supabase-transaction-pooler-url>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
ABUSE_HASH_SALT=<abuse-hash-salt>
INTERNAL_DIAGNOSTICS_TOKEN=<internal-diagnostics-token>
INTAKE_BUCKET=<intake-bucket-name>
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
# JSON object with all 18 server-owned product/currency mappings; use sandbox
# price IDs here, never client-side exchange rates.
STRIPE_PRICE_IDS={"risk_report_single:CNY":"price_...","risk_report_single:JPY":"price_...","risk_report_single:USD":"price_...","risk_report_single:TWD":"price_...","risk_report_single:HKD":"price_...","risk_report_single:SGD":"price_...","c_plus_monthly:CNY":"price_...","c_plus_monthly:JPY":"price_...","c_plus_monthly:USD":"price_...","c_plus_monthly:TWD":"price_...","c_plus_monthly:HKD":"price_...","c_plus_monthly:SGD":"price_...","b_data_pro_monthly:CNY":"price_...","b_data_pro_monthly:JPY":"price_...","b_data_pro_monthly:USD":"price_...","b_data_pro_monthly:TWD":"price_...","b_data_pro_monthly:HKD":"price_...","b_data_pro_monthly:SGD":"price_..."}
BILLING_SUCCESS_URL=https://<app-domain>/mypage.html
BILLING_CANCEL_URL=https://<app-domain>/mypage.html
BILLING_PORTAL_RETURN_URL=https://<app-domain>/mypage.html
ALLOWED_ORIGINS=https://zoubeacon.app,https://www.zoubeacon.app,https://platform.zoubeacon.com
APP_VERSION=lightsail-2026-09
# Production required: explicit admin gate; default false keeps the admin platform closed.
ADMIN_ENABLED=false

# Production optional settings.
JPPSKILL_BASE_URL=http://jpsskill:8100
JPPSKILL_TIMEOUT_SECONDS=30
RECOGNITION_AI_ENABLED=false

# Production optional: directory containing authorized licensed aggregate inputs; leave unset when collection is disabled.
LICENSED_AGGREGATE_DIR=<licensed-aggregate-directory>
# Production optional: application log severity; default is the application-configured level.
LOG_LEVEL=<log-level>
# Production optional: third-party log severity; default is the application-configured level.
LOG_THIRD_PARTY_LEVEL=<third-party-log-level>
# Production optional: MLIT API credential for authorized MLIT import jobs.
MLIT_API_KEY=<mlit-api-key>
# Production optional: MLIT XIT001 endpoint override; leave unset to use the code default.
MLIT_XIT001_URL=<mlit-xit001-url>
# Production optional: outbound request timeout seconds; default 8.0.
OUTBOUND_TIMEOUT_SECONDS=8.0
# Production optional: outbound retry attempts; default 2.
OUTBOUND_MAX_ATTEMPTS=2
# Production optional: outbound retry backoff base seconds; default 0.25.
OUTBOUND_BACKOFF_BASE_SECONDS=0.25
# Production optional: comma-separated retryable HTTP status codes; default 408,425,429,500,502,503,504.
OUTBOUND_TRANSIENT_STATUS_CODES=408,425,429,500,502,503,504
# Production optional: pricing catalog cache TTL; leave unset to use the code default.
PRICING_CACHE_TTL_SECONDS=<pricing-cache-ttl-seconds>
# Production optional: provenance freshness timestamp supplied by the ingestion workflow.
PROVENANCE_LAST_SUCCESS_AT=<provenance-last-success-at>
# Production optional: provenance parser version supplied by the ingestion workflow.
PROVENANCE_PARSER_VERSION=<provenance-parser-version>
# Production optional: provenance status supplied by the ingestion workflow.
PROVENANCE_STATUS=<provenance-status>
# Production optional: renovation-vision provider endpoint; leave unset when the feature is disabled.
RENOVATION_VISION_API_URL=<renovation-vision-api-url>
# Production optional: renovation-vision provider token; required only when the feature is enabled.
RENOVATION_VISION_API_TOKEN=<renovation-vision-api-token>
# Production optional: report worker one-shot mode for operator or local use; default is continuous mode.
REPORT_WORKER_ONCE=false
# Production optional: reverse-geocoder endpoint; leave unset to use the code default.
REVERSE_GEOCODER_URL=<reverse-geocoder-url>
# Production optional: reverse-geocoder timeout seconds; leave unset to use the code default.
REVERSE_GEOCODER_TIMEOUT_SECONDS=<reverse-geocoder-timeout-seconds>
# Production optional: query rate limit per hour; default 20.
QUERY_RATE_LIMIT_PER_HOUR=20
# Production optional: invitation registration rate limit per hour; default 5.
INVITE_REGISTER_RATE_LIMIT_PER_HOUR=5
# Production optional: staging project reference used only by staging schema inspection tooling.
SUPABASE_STAGING_REF=<staging-project-ref>
# Production optional: backup PostgreSQL client image; leave unset to use the code default.
BACKUP_PG_CLIENT_IMAGE=<backup-postgres-client-image>
# Production optional: local backup retention days; leave unset to use the code default.
BACKUP_RETENTION_DAYS=<backup-retention-days>
# Production optional: S3-compatible backup target. Leave any of the five
# required values unset to keep backups local-only. Cloudflare R2 example:
#   endpoint https://<account-id>.r2.cloudflarestorage.com , region auto ,
#   bucket <bucket-name> ; use an Object Read & Write token scoped to that
#   single bucket. R2 charges no egress.
BACKUP_S3_ACCESS_KEY_ID=<backup-s3-access-key-id>
BACKUP_S3_BUCKET=<backup-s3-bucket>
BACKUP_S3_ENDPOINT=<backup-s3-endpoint-url>
BACKUP_S3_PREFIX=zouseeking/database
BACKUP_S3_REGION=auto
# Production optional: remote backup retention days; defaults to BACKUP_RETENTION_DAYS (14).
BACKUP_S3_RETENTION_DAYS=<backup-s3-retention-days>
BACKUP_S3_SECRET_ACCESS_KEY=<backup-s3-secret-access-key>

# CI injected: runtime injected by CI; do not set in .env.
GITHUB_REF_NAME=<ci-ref-name>
# CI injected: runtime injected by CI; do not set in .env.
GITHUB_SHA=<ci-commit-sha>
