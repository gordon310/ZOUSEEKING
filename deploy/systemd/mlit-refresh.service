[Unit]
Description=Refresh ZOUSEEKING MLIT transaction statistics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
LogsDirectory=zouseeking
Environment=MLIT_REFRESH_LOG=/var/log/zouseeking/mlit-refresh.log
WorkingDirectory=/opt/zouseeking
EnvironmentFile=-/opt/zouseeking/deploy/.env
ExecStart=/opt/zouseeking/deploy/mlit-refresh.sh
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
