{
  "schema_version": 1,
  "contract": "migration-ledger-contract/v1",
  "purpose": "Offline gate for the G4 migration dimension of the 2026-10-07 countdown (D-7): the canonical forward history must be append-only, byte-stable for every already-applied migration, still matching every hash that was recorded on the production line, still matching the live documents that claim a zero-gap ledger, and free of unregistered destructive statements. It is offline and read-only: no network, no socket, no credentials, no environment variables, no database, no SQL execution. It never proves that production really holds these 54 versions and never replaces a live ledger read.",
  "canonical_history": "supabase/migrations",
  "migration_name_pattern": "^(?P<version>\\d{14})_[a-z0-9][a-z0-9_]*\\.sql$",
  "manifest": {
    "path": "docs/architecture/schema-ownership.json",
    "key": "forward_migration_files"
  },
  "recorded_artifacts": [
    {
      "id": "m1_baseline_reconciliation_apply",
      "evidence": "docs/release/m1-database-production-line-evidence.json",
      "file_pointer": "/migration/file",
      "sha256_pointer": "/migration/sha256",
      "note": "Applied to the authorized staging line on 2026-09-02; the recorded bytes must still exist in the repo."
    },
    {
      "id": "m1_service_role_portability_forward_fix",
      "evidence": "docs/release/m1-database-production-line-evidence.json",
      "file_pointer": "/migration/service_role_portability_forward_fix/file",
      "sha256_pointer": "/migration/service_role_portability_forward_fix/sha256",
      "note": "Forward fix recorded with the same staging apply evidence."
    }
  ],
  "live_ledger_claims": [
    {
      "id": "L1_go_live_readiness_summary",
      "document": "docs/release/2026-10-07-go-live-readiness-summary.md",
      "kind": "current",
      "pattern": "生产\\s*\\*\\*(?P<production>\\d+)\\s*/\\s*仓库\\s*(?P<repo>\\d+)\\*\\*[^\\n]*?最高\\s*`(?P<max_version>\\d{14})`",
      "occurrences_required": 1,
      "bindings": {
        "production": "repo_count",
        "repo": "repo_count",
        "max_version": "repo_max_version"
      },
      "note": "Release-artifact identity block; a fixed 54/54 zero-gap claim with a highest-version pointer."
    },
    {
      "id": "L2_go_no_go_checklist_a1",
      "document": "docs/release/go-no-go-checklist-2026-10-07.md",
      "kind": "current",
      "pattern": "生产已登记\\s*(?P<production>\\d+)\\s*条\\s*/\\s*仓库\\s*(?P<repo>\\d+)\\s*条[^\\n]*?最高登记\\s*`(?P<max_version>\\d{14})`",
      "occurrences_required": 1,
      "bindings": {
        "production": "repo_count",
        "repo": "repo_count",
        "max_version": "repo_max_version"
      },
      "note": "Checklist §A row A1; the current production-ledger claim of record."
    }
  ],
  "excluded_surfaces": [
    {
      "id": "dated_evidence_logs",
      "where": "docs/release/go-no-go-checklist-2026-10-07.md §D, docs/release/launch-readiness-log.md dated rows",
      "reason": "These record a measurement taken in a named round (for example §D reads '50 条' from before the 2026-09-25 forward batch). A dated log is allowed to be stale about the present; only current-state claims are bound here."
    },
    {
      "id": "live_production_ledger",
      "where": "supabase_migrations.schema_migrations (production)",
      "reason": "Reading the real ledger needs production credentials, which this gate must not use. The 54/54 claim is therefore only checked for consistency with the repo, not for truth against production."
    }
  ],
